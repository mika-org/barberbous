generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["barberbous"]
}

enum OrderType {
  WALK_IN
  BOOKING

  @@schema("barberbous")
}

enum DiscountType {
  PERCENT
  NOMINAL

  @@schema("barberbous")
}

enum PaymentMethod {
  TUNAI
  QRIS
  DEBIT

  @@schema("barberbous")
}

enum TransactionStatus {
  MENUNGGU_PEMBAYARAN
  SELESAI
  REFUND

  @@schema("barberbous")
}

enum BookingStatus {
  HADIR
  MENUNGGU
  SELESAI
  BATAL

  @@schema("barberbous")
}

enum CapsterStatus {
  TERSEDIA
  MELAYANI
  ISTIRAHAT

  @@schema("barberbous")
}

enum ItemType {
  PACKAGE
  DRINK

  @@schema("barberbous")
}

enum ShiftStatus {
  OPEN
  CLOSED

  @@schema("barberbous")
}

enum ActiveServiceStatus {
  MELAYANI
  SELESAI
  BATAL

  @@schema("barberbous")
}

model Package {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String
  price            Int
  imageUrl         String?
  badgeColor       String            @default("#EDE0CE")
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookings         Booking[]
  transactions     Transaction[]
  transactionItems TransactionItem[]
  activeServices   ActiveService[]

  @@schema("barberbous")
}

model Drink {
  id               String            @id @default(cuid())
  name             String            @unique
  category         String            @default("Minuman kemasan")
  price            Int
  stock            Int               @default(0)
  minStock         Int               @default(6)
  imageUrl         String?
  badgeColor       String            @default("#EDE0CE")
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  transactionItems TransactionItem[]
  stockLogs        StockLog[]

  @@schema("barberbous")
}

model StockLog {
  id            String   @id @default(cuid())
  drinkId       String
  drink         Drink    @relation(fields: [drinkId], references: [id], onDelete: Cascade)
  delta         Int
  previousStock Int
  newStock      Int
  note          String   @default("Restock kulkas")
  createdBy     String   @default("Kasir")
  createdAt     DateTime @default(now())

  @@schema("barberbous")
}

model Capster {
  id             String          @id @default(cuid())
  code           String          @default("CPS-01")
  name           String          @unique
  phone          String          @default("0812-0000-0000")
  photoUrl       String?
  bgColor        String          @default("#C4B5E3")
  status         CapsterStatus   @default(TERSEDIA)
  rating         Float           @default(4.9)
  commissionPct  Int             @default(40)
  joinedLabel    String          @default("Jan 2026")
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       Booking[]
  transactions   Transaction[]
  activeServices ActiveService[]
  kasbons        Kasbon[]

  @@schema("barberbous")
}

model Member {
  id              String          @id @default(cuid())
  memberCode      String          @unique
  name            String
  phone           String          @unique
  birthDate       String?
  notes           String?
  points          Int             @default(0)
  visits          Int             @default(0)
  lastVisitAt     DateTime?
  favoritePackage String?
  favoriteCapster String?
  isActive        Boolean         @default(true)
  joinedAt        DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  transactions    Transaction[]
  activeServices  ActiveService[]

  @@schema("barberbous")
}

model Voucher {
  id            String       @id @default(cuid())
  code          String       @unique
  label         String
  discountType  DiscountType
  discountValue Int
  minSubtotal   Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@schema("barberbous")
}

model Booking {
  id            String        @id @default(cuid())
  customerName  String
  customerPhone String?
  isMember      Boolean       @default(false)
  scheduledTime String
  bookingDate   DateTime      @default(now())
  status        BookingStatus @default(MENUNGGU)
  packageId     String
  package       Package       @relation(fields: [packageId], references: [id])
  capsterId     String
  capster       Capster       @relation(fields: [capsterId], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]

  @@schema("barberbous")
}

model ActiveService {
  id           String              @id @default(cuid())
  customerName String              @default("Umum")
  isMember     Boolean             @default(false)
  memberId     String?
  member       Member?             @relation(fields: [memberId], references: [id])
  packageId    String
  package      Package             @relation(fields: [packageId], references: [id])
  capsterId    String
  capster      Capster             @relation(fields: [capsterId], references: [id])
  bookingId    String?
  notes        String?
  status       ActiveServiceStatus @default(MELAYANI)
  startedAt    DateTime            @default(now())
  completedAt  DateTime?

  @@schema("barberbous")
}

model CashShift {
  id                  String        @id @default(cuid())
  status              ShiftStatus   @default(OPEN)
  openingCash         Int           @default(0)
  closingCashActual   Int?
  closingCashExpected Int?
  openedBy            String
  closedBy            String?
  notes               String?
  openedAt            DateTime      @default(now())
  closedAt            DateTime?
  expenses            CashExpense[]
  kasbons             Kasbon[]

  @@schema("barberbous")
}

model Kasbon {
  id          String     @id @default(cuid())
  capsterId   String
  capster     Capster    @relation(fields: [capsterId], references: [id], onDelete: Cascade)
  amount      Int
  date        DateTime   @default(now())
  notes       String?
  shiftId     String?
  shift       CashShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdBy   String     @default("Kasir")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@schema("barberbous")
}

model CashExpense {
  id          String    @id @default(cuid())
  shiftId     String
  shift       CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  amount      Int
  description String
  category    String    @default("Operasional")
  createdBy   String    @default("Kasir")
  createdAt   DateTime  @default(now())

  @@schema("barberbous")
}

model StoreExpense {
  id             String        @id @default(cuid())
  amount         Int
  description    String
  category       String        @default("Operasional")
  paymentMethod  PaymentMethod @default(TUNAI)
  notes          String?
  shiftExpenseId String?       @unique
  createdBy      String        @default("Kasir")
  expenseDate    DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@schema("barberbous")
}

model Transaction {
  id                 String            @id @default(cuid())
  orderNumber        Int               @unique
  orderCode          String            @unique
  orderType          OrderType         @default(WALK_IN)
  customerName       String            @default("Umum")
  isMember           Boolean           @default(false)
  memberId           String?
  member             Member?           @relation(fields: [memberId], references: [id])
  packageId          String?
  package            Package?          @relation(fields: [packageId], references: [id])
  packageName        String            @default("")
  packageDescription String            @default("")
  capsterId          String?
  capster            Capster?          @relation(fields: [capsterId], references: [id])
  capsterName        String            @default("-")
  bookingId          String?
  booking            Booking?          @relation(fields: [bookingId], references: [id])
  subtotal           Int
  discountType       DiscountType?
  discountValue      Int               @default(0)
  discountAmount     Int               @default(0)
  discountLabel      String?
  voucherCode        String?
  redeemedPoints     Int               @default(0)
  pointsDiscount     Int               @default(0)
  taxAmount              Int               @default(0)
  serviceFeeAmount       Int               @default(0)
  total                  Int
  capsterCommissionTotal Int               @default(0)
  ownerPackageShareTotal Int               @default(0)
  paymentMethod          PaymentMethod
  cashReceived       Int?
  changeAmount       Int?
  status             TransactionStatus @default(SELESAI)
  notes              String?
  cashierName        String            @default("Rehan")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  items              TransactionItem[]

  @@schema("barberbous")
}

model TransactionItem {
  id                 String      @id @default(cuid())
  transactionId      String
  transaction        Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  itemType           ItemType    @default(PACKAGE)
  packageId          String?
  package            Package?    @relation(fields: [packageId], references: [id])
  drinkId            String?
  drink              Drink?      @relation(fields: [drinkId], references: [id])
  capsterId          String?
  capsterName        String?
  packageName        String
  packageDescription String
  unitPrice          Int
  quantity           Int         @default(1)
  lineTotal          Int
  netPackageAmount   Int         @default(0)
  commissionPct      Int         @default(40)
  ownerPct           Int         @default(60)
  capsterCommission  Int         @default(0)
  ownerShare         Int         @default(0)

  @@schema("barberbous")
}

model StoreSetting {
  id                String   @id @default("default")
  storeName         String   @default("BARBERBOUS")
  address           String   @default("Jl. Turangga No. 12, Bandung")
  phone             String   @default("081234567890")
  printerName       String   @default("Epson TM-T82")
  printerConnection String   @default("Bluetooth · Printer utama")
  printerConnected  Boolean  @default(true)
  paperSize         String   @default("80 mm")
  autoPrintReceipt  Boolean  @default(true)
  receiptFooter     String   @default("Terima kasih, sampai jumpa!")
  taxEnabled        Boolean  @default(false)
  taxRate           Int      @default(10)
  serviceFeeEnabled Boolean  @default(false)
  serviceFeeAmount  Int      @default(0)
  priceIncludesTax  Boolean  @default(false)
  tunaiEnabled      Boolean  @default(true)
  qrisEnabled       Boolean  @default(true)
  debitEnabled      Boolean  @default(true)
  qrisMerchantName  String   @default("Barberbous, Service")
  qrisNmid          String   @default("ID1026609626373")
  qrisImageUrl      String   @default("/images/qris.jpeg")
  updatedAt         DateTime @updatedAt

  @@schema("barberbous")
}

model StaffUser {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  email        String?
  role         String   @default("Kasir")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("barberbous")
}
